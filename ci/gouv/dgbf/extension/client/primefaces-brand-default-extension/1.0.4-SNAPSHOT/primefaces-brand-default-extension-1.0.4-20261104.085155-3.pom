	<groupId>ci.gouv.dgbf.extension.client</groupId>
	<artifactId>primefaces-brand-default-extension</artifactId>
	<packaging>jar</packaging>

	<name>Primefaces default brand extension (DGBF visual identity: tokens, fonts, component skin)</name>
	<description>Static resources only (CSS and fonts), no Java and no dependency. Public contract: the semantic tokens of root.css.</description>

